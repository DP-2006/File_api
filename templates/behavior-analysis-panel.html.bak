{% load static %}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0B0B0F" />
  <title>Insight Console — کنسول تحلیل رفتار</title>
  <script>
    (function () {
      try {
        var t = localStorage.getItem('insight_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
    })();
  </script>
  <script src="{% static 'vendor/chartjs/chart.umd.min.js' %}"></script>
  <link rel="stylesheet" href="{% static 'vendor/vazirmatn/vazirmatn.css' %}" />
  <style>
    :root {
      --bg:#0B0B0F;--bg-elev:#131318;--bg-elev-2:#1A1A21;--bg-hover:#1F1F27;
      --border:#26262F;--border-strong:#32323D;--text:#EDEDF0;--text-2:#A0A0AC;--text-3:#6B6B78;
      --accent:#6366F1;--accent-hover:#7C7FF5;--accent-soft:rgba(99,102,241,.14);
      --green:#22C55E;--green-soft:rgba(34,197,94,.14);
      --red:#EF4444;--red-soft:rgba(239,68,68,.14);
      --orange:#F59E0B;--orange-soft:rgba(245,158,11,.14);
      --blue:#3B82F6;--purple:#A855F7;--teal:#14B8A6;
      --tip:#131318;--separator:#26262F;--label:#EDEDF0;--label-2:#A0A0AC;
      --shadow-sm:0 1px 2px rgba(0,0,0,.35);
      --shadow-md:0 4px 14px rgba(0,0,0,.45);
      --shadow-lg:0 18px 48px rgba(0,0,0,.55);
      --shadow-focus:0 0 0 3px rgba(99,102,241,.28);
      --r-sm:8px;--r-md:12px;--r-lg:16px;--r-xl:20px;--r-pill:999px;
      --ease:cubic-bezier(.4,0,.2,1);
      --header-h:64px;--sidebar-w:280px;--sidebar-w-collapsed:72px;
    }
    [data-theme="light"] {
      --bg:#F7F7F9;--bg-elev:#FFFFFF;--bg-elev-2:#F1F1F5;--bg-hover:#ECECF1;
      --border:#E5E5EA;--border-strong:#D4D4DB;--text:#18181B;--text-2:#55555F;--text-3:#8B8B96;
      --accent:#4F46E5;--accent-hover:#4338CA;--accent-soft:rgba(79,70,229,.10);
      --green:#16A34A;--green-soft:rgba(22,163,74,.12);
      --red:#DC2626;--red-soft:rgba(220,38,38,.10);
      --orange:#D97706;--orange-soft:rgba(217,119,6,.12);
      --blue:#2563EB;--purple:#9333EA;--teal:#0D9488;
      --tip:#FFFFFF;--separator:#E5E5EA;--label:#18181B;--label-2:#55555F;
      --shadow-sm:0 1px 2px rgba(0,0,0,.06);
      --shadow-md:0 4px 14px rgba(0,0,0,.08);
      --shadow-lg:0 18px 48px rgba(0,0,0,.14);
      --shadow-focus:0 0 0 3px rgba(79,70,229,.25);
    }
    *,*::before,*::after{box-sizing:border-box}
    html,body{height:100%}
    body{margin:0;font-family:Vazirmatn,Tahoma,sans-serif;font-size:14px;line-height:1.6;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
    button,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit}
    button{cursor:pointer;background:none;border:none;padding:0}
    button:disabled{cursor:not-allowed;opacity:.5}
    a{color:inherit}
    :focus-visible{outline:none;box-shadow:var(--shadow-focus);border-radius:var(--r-sm)}
    ::selection{background:var(--accent-soft)}
    ::-webkit-scrollbar{width:8px;height:8px}
    ::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:var(--r-pill)}
    ::-webkit-scrollbar-track{background:transparent}

    .app{display:grid;grid-template-columns:var(--sidebar-w) 1fr;grid-template-rows:var(--header-h) 1fr;grid-template-areas:"header header" "sidebar main";height:100dvh;overflow:hidden;transition:grid-template-columns .22s var(--ease)}
    .app.collapsed{grid-template-columns:var(--sidebar-w-collapsed) 1fr}

    .header{grid-area:header;display:flex;align-items:center;gap:12px;padding:0 16px;background:var(--bg-elev);border-bottom:1px solid var(--border);position:relative;z-index:30}
    .brand{display:flex;align-items:center;gap:10px;min-width:0}
    .brand-mark{width:28px;height:28px;border-radius:8px;flex:0 0 auto;display:grid;place-items:center;font-weight:800;font-size:12px;color:#fff;background:linear-gradient(135deg,var(--accent),var(--purple));box-shadow:var(--shadow-sm)}
    .brand-title{font-weight:700;font-size:14px;white-space:nowrap}
    .divider-v{width:1px;height:20px;background:var(--border)}
    .breadcrumb{color:var(--text-3);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .header-spacer{flex:1 1 auto}
    .live-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:var(--r-pill);background:var(--green-soft);color:var(--green);font-size:11px;font-weight:600;white-space:nowrap;border:1px solid transparent}
    .live-dot{width:7px;height:7px;border-radius:50%;background:var(--green);animation:pulse 2s var(--ease) infinite}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.45;transform:scale(.8)}}

    .user-chip{display:none;align-items:center;gap:8px;padding:4px 10px 4px 4px;border-radius:var(--r-pill);background:var(--bg-elev-2);border:1px solid var(--border);font-size:12px;font-weight:600;max-width:180px}
    .user-chip.visible{display:inline-flex}
    .user-chip .avatar{width:28px;height:28px;font-size:11px}
    .user-chip .name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

    .icon-btn{width:36px;height:36px;border-radius:var(--r-sm);display:inline-grid;place-items:center;color:var(--text-2);transition:background .15s var(--ease),color .15s var(--ease)}
    .icon-btn:hover{background:var(--bg-hover);color:var(--text)}
    .icon-btn svg{width:18px;height:18px}
    .icon-btn.spinning svg{animation:spin .7s var(--ease)}
    @keyframes spin{to{transform:rotate(360deg)}}

    .sidebar{grid-area:sidebar;background:var(--bg-elev);border-inline-end:1px solid var(--border);display:flex;flex-direction:column;min-height:0;overflow:hidden;transition:width .22s var(--ease)}
    .sidebar-head{display:flex;align-items:center;justify-content:space-between;padding:16px 16px 8px}
    .sidebar-title{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text-3)}
    .count-badge{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 6px;border-radius:var(--r-pill);background:var(--accent-soft);color:var(--accent);font-size:11px;font-weight:700}
    .search-wrap{padding:0 12px 10px}
    .search-box{display:flex;align-items:center;gap:8px;background:var(--bg-elev-2);border:1px solid var(--border);border-radius:var(--r-sm);padding:7px 10px;transition:box-shadow .15s var(--ease),border-color .15s var(--ease)}
    .search-box:focus-within{border-color:var(--accent);box-shadow:var(--shadow-focus)}
    .search-box svg{width:15px;height:15px;color:var(--text-3);flex:0 0 auto}
    .search-box input{flex:1 1 auto;min-width:0;border:none;outline:none;background:transparent;font-size:13px}
    .search-box input::placeholder{color:var(--text-3)}

    .user-list{flex:1 1 auto;overflow-y:auto;padding:0 8px 12px;min-height:0}
    .user-item{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;margin-bottom:2px;border-radius:var(--r-md);text-align:start;border-inline-start:3px solid transparent;transition:background .15s var(--ease)}
    .user-item:hover{background:var(--bg-hover)}
    .user-item.active{background:var(--accent-soft);border-inline-start-color:var(--accent)}
    .user-item .avatar{flex:0 0 auto}
    .user-meta{min-width:0;flex:1 1 auto}
    .user-name{font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .user-sub{font-size:11px;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

    .app.collapsed .sidebar-head,.app.collapsed .search-wrap{display:none}
    .app.collapsed .user-meta{display:none}
    .app.collapsed .user-item{justify-content:center;padding:10px 0}
    .app.collapsed .user-list{padding:12px 6px}

    .avatar{width:40px;height:40px;border-radius:var(--r-pill);display:grid;place-items:center;font-weight:700;font-size:13px;color:#fff;flex:0 0 auto;user-select:none}

    .skeleton-row{display:flex;align-items:center;gap:10px;padding:10px 10px}
    .sk{background:linear-gradient(90deg,var(--bg-elev-2) 25%,var(--bg-hover) 50%,var(--bg-elev-2) 75%);background-size:200% 100%;animation:shimmer 1.3s linear infinite;border-radius:var(--r-sm)}
    @keyframes shimmer{to{background-position:-200% 0}}
    .sk-avatar{width:40px;height:40px;border-radius:50%;flex:0 0 auto}
    .sk-lines{flex:1 1 auto;display:flex;flex-direction:column;gap:6px}
    .sk-line-1{height:10px;width:60%}
    .sk-line-2{height:9px;width:85%}
    .empty-side{padding:32px 16px;text-align:center;color:var(--text-3);font-size:12px}
    .empty-side .big{font-size:26px;margin-bottom:8px;display:block}

    .main{grid-area:main;overflow-y:auto;overflow-x:hidden;background:var(--bg);min-height:0;position:relative}
    .main-inner{max-width:1180px;margin:0 auto;padding:24px 24px 64px}
    .empty-block{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:64px 24px;text-align:center;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--r-lg);min-height:320px}
    .empty-block .big{font-size:40px;line-height:1;margin-bottom:4px}
    .empty-block h3{margin:0;font-size:16px}
    .empty-block p{margin:0;color:var(--text-3);font-size:13px;max-width:360px}

    .card{background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--r-lg)}
    .section-gap{margin-bottom:16px}

    .uhead{display:flex;align-items:center;gap:14px;padding:16px}
    .uhead .avatar{width:56px;height:56px;font-size:18px}
    .uhead-main{flex:1 1 auto;min-width:0}
    .uhead-name{font-size:16px;font-weight:700}
    .uhead-sub{font-size:12px;color:var(--text-3)}

    .kpi-strip{display:flex;align-items:stretch;flex-wrap:wrap;padding:0;overflow:hidden}
    .kpi-cell{flex:1 1 120px;min-width:110px;padding:12px 16px;height:72px;display:flex;flex-direction:column;justify-content:center;gap:2px;border-inline-end:1px solid var(--border)}
    .kpi-cell:last-child{border-inline-end:none}
    .kpi-value{font-size:22px;font-weight:700;line-height:1.15;font-variant-numeric:tabular-nums}
    .kpi-label{font-size:11px;color:var(--text-3)}
    .kpi-add{display:flex;align-items:center;justify-content:center;color:var(--text-3);font-size:22px;min-width:72px;border:1px dashed var(--border-strong);border-radius:var(--r-md);margin:10px;height:52px;flex:0 0 auto;transition:color .15s var(--ease),border-color .15s var(--ease),background .15s var(--ease)}
    .kpi-add:hover{color:var(--accent);border-color:var(--accent);background:var(--accent-soft)}
    .kpi-custom{position:relative}
    .kpi-custom .kpi-remove{position:absolute;top:4px;inset-inline-end:6px;width:18px;height:18px;border-radius:50%;display:grid;place-items:center;font-size:11px;color:var(--text-3);opacity:0;transition:opacity .15s var(--ease),background .15s var(--ease)}
    .kpi-custom:hover .kpi-remove{opacity:1}
    .kpi-custom .kpi-remove:hover{background:var(--red-soft);color:var(--red)}

    .tabbar{position:sticky;top:0;z-index:20;display:flex;gap:4px;background:color-mix(in srgb,var(--bg) 82%,transparent);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);padding:0 2px;margin-bottom:20px}
    .tab{position:relative;padding:12px 14px;font-size:13px;font-weight:600;color:var(--text-2);display:inline-flex;align-items:center;gap:6px;transition:color .15s var(--ease);white-space:nowrap}
    .tab::after{content:"";position:absolute;bottom:-1px;inset-inline:8px;height:2px;border-radius:2px;background:var(--accent);transform:scaleX(0);transition:transform .15s var(--ease)}
    .tab:hover{color:var(--text)}
    .tab.active{color:var(--text)}
    .tab.active::after{transform:scaleX(1)}
    .tab .badge{font-size:10px;font-weight:700;padding:1px 7px;border-radius:var(--r-pill);background:var(--bg-elev-2);color:var(--text-2)}
    .tab.active .badge{background:var(--accent-soft);color:var(--accent)}

    .panel{display:none;animation:fadeIn .2s var(--ease)}
    .panel.active{display:block}
    @keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

    .chart-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
    .chart-card{padding:16px;min-height:300px;display:flex;flex-direction:column}
    .chart-card h4{margin:0 0 12px;font-size:13px;font-weight:700;color:var(--text);display:flex;align-items:center;justify-content:space-between;gap:8px}
    .chart-card h4 .hint{font-size:10px;font-weight:400;color:var(--text-3)}
    .chart-box{position:relative;flex:1 1 auto;min-height:220px}
    .no-data{flex:1 1 auto;min-height:220px;display:grid;place-items:center;color:var(--text-3);font-size:13px;border:1px dashed var(--border);border-radius:var(--r-md)}

    .drilldown{margin-top:16px;padding:16px;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--r-lg);animation:fadeIn .2s var(--ease)}
    .drill-head{display:flex;align-items:center;gap:12px;margin-bottom:14px;flex-wrap:wrap}
    .drill-title{font-weight:700;font-size:14px}
    .drill-stats{display:flex;gap:20px;flex-wrap:wrap}
    .drill-stat{display:flex;flex-direction:column}
    .drill-stat b{font-size:16px;font-variant-numeric:tabular-nums}
    .drill-stat span{font-size:11px;color:var(--text-3)}
    .drill-files{max-height:240px;overflow-y:auto;border:1px solid var(--border);border-radius:var(--r-md);background:var(--bg-elev-2)}
    .drill-file{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 12px;border-bottom:1px solid var(--separator);font-size:12px}
    .drill-file:last-child{border-bottom:none}
    .drill-file .fname{dir:ltr;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1 1 auto}
    .drill-file .frelevance{font-variant-numeric:tabular-nums;color:var(--text-2);flex:0 0 auto}

    .chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
    .chip{padding:6px 12px;border-radius:var(--r-pill);font-size:12px;font-weight:600;border:1px solid var(--border);color:var(--text-2);display:inline-flex;align-items:center;gap:6px;transition:all .15s var(--ease)}
    .chip:hover{border-color:var(--border-strong);color:var(--text)}
    .chip.active{background:var(--accent-soft);color:var(--accent);border-color:var(--accent)}
    .chip .n{font-size:10px;opacity:.8}

    .table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--r-lg);background:var(--bg-elev)}
    table.files{width:100%;border-collapse:collapse;font-size:12.5px}
    table.files th{text-align:start;font-size:11px;font-weight:700;color:var(--text-3);padding:10px 14px;border-bottom:1px solid var(--border);white-space:nowrap}
    table.files td{padding:10px 14px;border-bottom:1px solid var(--separator);vertical-align:middle}
    table.files tr:last-child td{border-bottom:none}
    table.files tbody tr{transition:background .12s var(--ease)}
    table.files tbody tr:hover{background:var(--bg-hover)}
    .fname-cell{max-width:280px}
    .fname-cell .f{dir:ltr;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block}
    .pill{display:inline-flex;align-items:center;gap:4px;padding:2px 9px;border-radius:var(--r-pill);font-size:11px;font-weight:600;white-space:nowrap}
    .pill.ok{background:var(--green-soft);color:var(--green)}
    .pill.bad{background:var(--red-soft);color:var(--red)}
    .pill.warn{background:var(--orange-soft);color:var(--orange)}
    .scorebar{display:flex;align-items:center;gap:8px;min-width:120px}
    .scorebar .track{flex:1 1 auto;height:6px;border-radius:var(--r-pill);background:var(--bg-elev-2);overflow:hidden}
    .scorebar .fill{height:100%;border-radius:var(--r-pill);background:var(--accent);width:0;transition:width .6s var(--ease)}
    .scorebar .val{font-size:11px;font-variant-numeric:tabular-nums;color:var(--text-2);min-width:32px;text-align:end}

    .chat-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:14px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 14px;border-radius:var(--r-sm);font-size:12.5px;font-weight:600;border:1px solid var(--border);background:var(--bg-elev-2);color:var(--text);transition:all .15s var(--ease);white-space:nowrap}
    .btn:hover:not(:disabled){border-color:var(--border-strong);background:var(--bg-hover)}
    .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
    .btn.primary:hover:not(:disabled){background:var(--accent-hover);border-color:var(--accent-hover)}
    .btn.danger{background:var(--red-soft);border-color:transparent;color:var(--red)}
    .input-text{flex:1 1 160px;min-width:120px;padding:8px 12px;border-radius:var(--r-sm);background:var(--bg-elev-2);border:1px solid var(--border);font-size:12.5px;outline:none}
    .input-text:focus{border-color:var(--accent);box-shadow:var(--shadow-focus)}
    .chat-status{font-size:11px;color:var(--text-3)}

    .chat-shell{display:flex;flex-direction:column;height:520px}
    .chat-messages{flex:1 1 auto;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--r-lg) var(--r-lg) 0 0}
    .chat-empty{flex:1 1 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:var(--text-3);font-size:12.5px;text-align:center;padding:24px}
    .chat-empty .big{font-size:32px}
    .msg{display:flex;gap:8px;max-width:82%}
    .msg.user{align-self:flex-end;flex-direction:row-reverse}
    .msg.assistant{align-self:flex-start}
    .msg .avatar{width:28px;height:28px;font-size:10px}
    .bubble{padding:9px 13px;border-radius:var(--r-md);font-size:13px;background:var(--bg-elev-2);border:1px solid var(--border);white-space:pre-wrap;word-break:break-word;position:relative;line-height:1.65}
    .msg.user .bubble{background:var(--accent-soft);border-color:transparent}
    .msg-time{position:absolute;bottom:-16px;font-size:9.5px;color:var(--text-3);opacity:0;transition:opacity .15s var(--ease);white-space:nowrap}
    .msg:hover .msg-time{opacity:1}
    .msg.user .msg-time{inset-inline-end:0}
    .msg.assistant .msg-time{inset-inline-start:0}
    .typing{display:inline-flex;gap:4px;padding:4px 2px}
    .typing span{width:6px;height:6px;border-radius:50%;background:var(--text-3);animation:blink 1.2s var(--ease) infinite}
    .typing span:nth-child(2){animation-delay:.15s}
    .typing span:nth-child(3){animation-delay:.3s}
    @keyframes blink{0%,60%,100%{opacity:.25}30%{opacity:1}}

    .chat-input-row{display:flex;align-items:flex-end;gap:8px;padding:10px;background:var(--bg-elev);border:1px solid var(--border);border-top:none;border-radius:0 0 var(--r-lg) var(--r-lg)}
    .chat-input-row textarea{flex:1 1 auto;resize:none;min-height:40px;max-height:150px;padding:9px 12px;border-radius:var(--r-sm);background:var(--bg-elev-2);border:1px solid var(--border);outline:none;font-size:13px;line-height:1.5}
    .chat-input-row textarea:focus{border-color:var(--accent);box-shadow:var(--shadow-focus)}

    .img-result{margin-top:12px;border:1px solid var(--border);border-radius:var(--r-lg);padding:12px;background:var(--bg-elev);position:relative}
    .img-result img{max-width:100%;border-radius:var(--r-md);display:block;cursor:zoom-in}
    .img-result .caption{font-size:11px;color:var(--text-3);margin-top:8px}
    .img-close{position:absolute;top:8px;inset-inline-end:8px;width:26px;height:26px;border-radius:50%;background:var(--bg-elev-2);color:var(--text-2);display:grid;place-items:center;font-size:14px;border:1px solid var(--border)}
    .img-close:hover{background:var(--red-soft);color:var(--red)}

    .lightbox{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.8);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);display:grid;place-items:center;padding:24px;animation:fadeIn .15s var(--ease)}
    .lightbox img{max-width:92vw;max-height:88vh;border-radius:var(--r-md);box-shadow:var(--shadow-lg)}

    .psy-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px}
    .psy-scores{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}
    .score-card{padding:14px;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--r-md);display:flex;flex-direction:column;gap:4px}
    .score-card .lbl{font-size:11.5px;color:var(--text-3);display:flex;align-items:center;gap:6px}
    .score-card .dot{width:8px;height:8px;border-radius:50%;flex:0 0 auto}
    .score-card .val{font-size:22px;font-weight:700;font-variant-numeric:tabular-nums}
    .psy-narrative{background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--r-lg);padding:16px;margin-bottom:14px;max-width:720px;line-height:1.9;font-size:13px;color:var(--text-2)}
    .signals{display:flex;gap:6px;flex-wrap:wrap}
    .signal-pill{padding:3px 10px;border-radius:var(--r-pill);background:var(--bg-elev-2);border:1px solid var(--border);font-size:11px;color:var(--text-2);direction:ltr}
    .progress-card{display:flex;align-items:center;gap:10px;padding:14px 16px;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--r-lg);margin-top:14px}
    .spinner{width:18px;height:18px;border-radius:50%;border:2.5px solid var(--border-strong);border-top-color:var(--accent);animation:spin .8s linear infinite;flex:0 0 auto}

    .toast-stack{position:fixed;bottom:20px;inset-inline-end:20px;z-index:300;display:flex;flex-direction:column;gap:8px;max-width:340px}
    .toast{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;border-radius:var(--r-md);background:var(--bg-elev);border:1px solid var(--border);box-shadow:var(--shadow-lg);font-size:12.5px;animation:toastIn .22s var(--ease)}
    .toast .t-icon{flex:0 0 auto;font-size:15px;line-height:1.4}
    .toast.success{border-inline-start:3px solid var(--green)}.toast.success .t-icon{color:var(--green)}
    .toast.error{border-inline-start:3px solid var(--red)}.toast.error .t-icon{color:var(--red)}
    .toast.info{border-inline-start:3px solid var(--blue)}.toast.info .t-icon{color:var(--blue)}
    .toast.warning{border-inline-start:3px solid var(--orange)}.toast.warning .t-icon{color:var(--orange)}
    @keyframes toastIn{from{opacity:0;transform:translateY(8px) scale(.97)}to{opacity:1;transform:none}}
    .toast.out{animation:toastOut .2s var(--ease) forwards}
    @keyframes toastOut{to{opacity:0;transform:translateY(6px) scale(.97)}}

    .dialog-backdrop{position:fixed;inset:0;z-index:250;background:rgba(0,0,0,.55);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);display:grid;place-items:center;padding:20px;animation:fadeIn .15s var(--ease)}
    .dialog{width:100%;max-width:420px;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:var(--shadow-lg);padding:20px;animation:dialogIn .2s var(--ease)}
    @keyframes dialogIn{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:none}}
    .dialog h3{margin:0 0 8px;font-size:15px}
    .dialog p{margin:0 0 16px;font-size:12.5px;color:var(--text-2);line-height:1.7}
    .dialog-actions{display:flex;justify-content:flex-end;gap:8px}
    .check-row{display:flex;align-items:center;gap:8px;margin-bottom:14px;font-size:12.5px;color:var(--text-2)}
    .check-row input{accent-color:var(--accent);width:15px;height:15px}

    .drawer-backdrop{position:fixed;inset:0;z-index:250;background:rgba(0,0,0,.45);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);animation:fadeIn .15s var(--ease)}
    .drawer{position:fixed;top:0;bottom:0;inset-inline-end:0;z-index:260;width:100%;max-width:360px;background:var(--bg-elev);border-inline-start:1px solid var(--border);box-shadow:var(--shadow-lg);display:flex;flex-direction:column;animation:drawerIn .22s var(--ease)}
    @keyframes drawerIn{from{transform:translateX(-100%)}to{transform:none}}
    .drawer-head{display:flex;align-items:center;justify-content:space-between;padding:16px;border-bottom:1px solid var(--border)}
    .drawer-head h3{margin:0;font-size:14px}
    .drawer-body{padding:16px;display:flex;flex-direction:column;gap:14px;overflow-y:auto;flex:1 1 auto}
    .drawer-foot{padding:16px;border-top:1px solid var(--border);display:flex;gap:8px;justify-content:flex-end}
    .field{display:flex;flex-direction:column;gap:6px}
    .field label{font-size:12px;font-weight:600;color:var(--text-2)}
    .field input,.field select{padding:9px 12px;border-radius:var(--r-sm);background:var(--bg-elev-2);border:1px solid var(--border);font-size:13px;outline:none}
    .field input:focus,.field select:focus{border-color:var(--accent);box-shadow:var(--shadow-focus)}
    .field .hint{font-size:11px;color:var(--text-3)}

    @media (max-width:960px){
      .app{grid-template-columns:1fr;grid-template-rows:var(--header-h) auto 1fr;grid-template-areas:"header" "sidebar" "main";height:100dvh}
      .app.collapsed{grid-template-columns:1fr}
      .sidebar{border-inline-end:none;border-bottom:1px solid var(--border);max-height:200px}
      .sidebar-head,.search-wrap{display:none !important}
      .user-list{display:flex;flex-direction:row;overflow-x:auto;overflow-y:hidden;padding:10px;gap:8px}
      .user-item{flex:0 0 auto;width:150px;margin-bottom:0;border-inline-start:none;border-bottom:3px solid transparent}
      .user-item.active{border-inline-start-color:transparent;border-bottom-color:var(--accent)}
      .app.collapsed .user-meta{display:block}
      .app.collapsed .user-item{justify-content:flex-start;padding:8px 10px}
      .chart-grid{grid-template-columns:1fr}
      .psy-scores{grid-template-columns:repeat(2,minmax(0,1fr))}
      .uhead{flex-wrap:wrap}
      .kpi-cell{flex:1 1 100px;min-width:90px;padding:10px 12px}
      .brand-title{display:none}
      .breadcrumb{display:none}
      .divider-v{display:none}
      table.files .col-topic{display:none}
      .main-inner{padding:16px 12px 48px}
    }
    @media (prefers-reduced-motion:reduce){
      *,*::before,*::after{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important}
    }
  </style>
</head>
<body>
  <div class="app" id="app">
    <header class="header" role="banner">
      <button class="icon-btn" id="sidebarToggle" aria-label="باز و بسته کردن نوار کناری">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">AI</div>
        <span class="brand-title">گزارشات هوش مصنوعی</span>
      </div>
      <div class="divider-v" aria-hidden="true"></div>
      <div class="breadcrumb">تنظیمات / داشبورد تحلیل</div>
      <div class="header-spacer"></div>
      <div class="live-pill" title="به‌روزرسانی خودکار هر ۳۰ ثانیه">
        <span class="live-dot" aria-hidden="true"></span>
        <span>زنده · ۳۰s</span>
      </div>
      <div class="user-chip" id="headerUserChip">
        <span class="avatar" id="headerUserAvatar"></span>
        <span class="name" id="headerUserName"></span>
      </div>
      <button class="icon-btn" id="themeToggle" aria-label="تغییر تم روشن و تاریک">
        <svg id="themeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <button class="icon-btn" id="refreshBtn" aria-label="به‌روزرسانی داده‌ها">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M23 4v6h-6M1 20v-6h6"/>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
        </svg>
      </button>
    </header>

    <aside class="sidebar" role="complementary" aria-label="لیست کاربران">
      <div class="sidebar-head">
        <span class="sidebar-title">کاربران</span>
        <span class="count-badge" id="userCountBadge">۰</span>
      </div>
      <div class="search-wrap">
        <div class="search-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
          </svg>
          <input id="userSearch" type="text" placeholder="جستجوی کاربر…" aria-label="جستجوی کاربر" autocomplete="off" />
        </div>
      </div>
      <div class="user-list" id="userList" role="listbox" aria-label="کاربران"></div>
    </aside>

    <main class="main" id="main" tabindex="-1">
      <div class="main-inner" id="mainInner">
        <div class="empty-block" id="initialEmpty">
          <div class="big" aria-hidden="true">📊</div>
          <h3>داشبورد تحلیل رفتار</h3>
          <p>یک کاربر را از لیست انتخاب کنید تا تحلیل رفتار او نمایش داده شود.</p>
        </div>
      </div>
    </main>
  </div>

  <div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="false"></div>
  <div id="dialogMount"></div>
  <div id="drawerMount"></div>

  <script>
    /* ═══════════════ HELPERS ═══════════════ */
    const $ = (sel, root = document) => root.querySelector(sel);
    const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
    const FA_DIGITS = ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'];
    const toFa = (n) => (n === null || n === undefined) ? '—' : String(n).replace(/\d/g, d => FA_DIGITS[+d]);

    // Percent: accepts 0..1 OR 0..100 OR "83%"
    function fmtRel(v) {
      if (v === null || v === undefined) return '—';
      if (typeof v === 'string' && v.endsWith('%')) return toFa(v.replace('%','')) + '٪';
      let x = Number(v);
      if (isNaN(x)) return '—';
      if (x <= 1.0001) x = x * 100;
      x = Math.round(x * 10) / 10;
      return toFa(Number.isInteger(x) ? x : x.toFixed(1)) + '٪';
    }
    const clamp01 = (v) => Math.max(0, Math.min(1, Number(v) || 0));
    const nowTimeFa = () => {
      const d = new Date();
      return toFa(String(d.getHours()).padStart(2,'0')) + ':' + toFa(String(d.getMinutes()).padStart(2,'0'));
    };
    function escapeHtml(str) {
      return String(str ?? '').replace(/[&<>"']/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[s]));
    }
    function debounce(fn, ms) { let t; return function(...a){clearTimeout(t);t=setTimeout(()=>fn.apply(this,a),ms);}; }
    function getCookie(name) {
      const m = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([.$?*|{}()[\]\\/+^])/g,'\\$1') + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : '';
    }
    const uid = () => 'id_' + Math.random().toString(36).slice(2,9);

    async function apiFetch(url, options = {}) {
      const opts = { headers: {}, ...options };
      const method = (opts.method || 'GET').toUpperCase();
      if (method !== 'GET' && method !== 'HEAD') {
        opts.headers['X-CSRFToken'] = getCookie('csrftoken');
        if (!opts.headers['Content-Type'] && !(opts.body instanceof FormData)) {
          opts.headers['Content-Type'] = 'application/json';
        }
      }
      const res = await fetch(url, opts);
      const ct = res.headers.get('content-type') || '';
      let data = ct.includes('application/json') ? await res.json() : await res.text();
      if (!res.ok) {
        const err = new Error((data && data.error) || ('خطا در ارتباط با سرور (' + res.status + ')'));
        err.status = res.status; err.data = data; throw err;
      }
      return data;
    }

    /* ── FILE / TOPIC / TREND NORMALIZERS (fix bugs 1,2,3) ── */
    function pickFile(f) {
      if (!f || typeof f !== 'object') return { name:'—', topic:'—', rel:0, related:false, suspicious:false, org:false };
      const a = (f.analysis && typeof f.analysis === 'object') ? f.analysis : {};
      const name = f.name || f.filename || f.file_name || f.original_name || f.title || a.name || '—';
      const topic = f.topic || f.topic_name || f.category || a.topic || a.topic_name || '—';
      let rel = f.relevance_score ?? f.relevance ?? f.relevance_percent ?? f.score ?? a.relevance_score ?? a.relevance ?? a.score ?? 0;
      if (typeof rel === 'string' && rel.endsWith('%')) rel = parseFloat(rel) / 100;
      rel = Number(rel) || 0;
      if (rel > 1) rel = rel / 100;
      const related = !!(f.is_related ?? f.related ?? a.is_related ?? a.related);
      const suspicious = !!(f.is_suspicious ?? f.suspicious ?? f.threat ?? a.is_suspicious ?? a.suspicious);
      const org = !!(f.is_org ?? f.org ?? f.organizational ?? a.is_org ?? a.org);
      return { name, topic, rel, related, suspicious, org, raw: f };
    }
    function pickTopicFile(f) {
      const p = pickFile(f);
      return { name: p.name, rel: p.rel, related: p.related, raw: f };
    }
    function pickTrendPoint(t) {
      if (!t || typeof t !== 'object') return { label:'', related:0, unrelated:0, alignment:null };
      const label = t.date || t.day || t.label || t.period || t.name || '';
      const related = Number(t.related ?? t.related_count ?? t.related_files ?? t.count_related ?? 0) || 0;
      const unrelated = Number(t.unrelated ?? t.unrelated_count ?? t.unrelated_files ?? t.count_unrelated ?? 0) || 0;
      let alignment = t.role_alignment ?? t.alignment ?? t.role_fit ?? t.fit ?? null;
      if (alignment !== null) {
        alignment = Number(alignment);
        if (isNaN(alignment)) alignment = null;
        else if (alignment <= 1.0001) alignment = alignment * 100;
      }
      return { label: String(label), related, unrelated, alignment };
    }

    const AVATAR_PALETTE = [
      ['#6366F1','#8B5CF6'],['#14B8A6','#0EA5E9'],['#F59E0B','#EF4444'],
      ['#EC4899','#8B5CF6'],['#22C55E','#14B8A6'],['#3B82F6','#6366F1'],
    ];
    function avatarStyle(id) {
      const key = String(id ?? '').split('').reduce((a,c)=>a+c.charCodeAt(0),0);
      const p = AVATAR_PALETTE[key % AVATAR_PALETTE.length];
      return 'background:linear-gradient(135deg,'+p[0]+','+p[1]+');';
    }
    function initialsOf(name) {
      const s = String(name || '?').trim();
      if (!s) return '؟';
      const parts = s.split(/\s+/);
      if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
      return s.slice(0,2).toUpperCase();
    }
    function svgIcon(name) {
      const icons = {
        close:'<path d="M18 6 6 18M6 6l12 12"/>',
        back:'<path d="M19 12H5M12 19l-7-7 7-7"/>'
      };
      return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'+(icons[name]||'')+'</svg>';
    }

    /* ═══════════════ THEME ═══════════════ */
    const Theme = {
      current() { return document.documentElement.getAttribute('data-theme') || 'dark'; },
      apply(theme, withTransition) {
        const root = document.documentElement;
        const doApply = () => {
          root.setAttribute('data-theme', theme);
          try { localStorage.setItem('insight_theme', theme); } catch(e) {}
          Theme.syncIcon();
          if (window.State && State.selectedUserId) {
            window.dispatchEvent(new CustomEvent('insight:theme-changed'));
          }
        };
        if (withTransition && document.startViewTransition) document.startViewTransition(doApply);
        else doApply();
      },
      toggle() { Theme.apply(Theme.current() === 'dark' ? 'light' : 'dark', true); },
      syncIcon() {
        const icon = $('#themeIcon');
        if (!icon) return;
        icon.innerHTML = Theme.current() === 'dark'
          ? '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>'
          : '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>';
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', Theme.current() === 'dark' ? '#0B0B0F' : '#F7F7F9');
      }
    };

    /* ═══════════════ TOAST & DIALOG ═══════════════ */
    const Toast = (function () {
      const stack = () => $('#toastStack');
      const ICONS = { success:'✓', error:'✕', info:'ℹ', warning:'⚠' };
      function show(message, variant='info', duration=4000) {
        const el = document.createElement('div');
        el.className = 'toast ' + variant;
        el.setAttribute('role','status');
        el.innerHTML = '<span class="t-icon" aria-hidden="true">'+(ICONS[variant]||'ℹ')+'</span><span class="t-text">'+escapeHtml(message)+'</span>';
        stack().appendChild(el);
        const timer = setTimeout(()=>dismiss(el), duration);
        el.addEventListener('click', ()=>{clearTimeout(timer);dismiss(el);});
        return el;
      }
      function dismiss(el) {
        if (!el || el.classList.contains('out')) return;
        el.classList.add('out');
        setTimeout(()=>el.remove(), 220);
      }
      return { show, success:(m,d)=>show(m,'success',d), error:(m,d)=>show(m,'error',d), info:(m,d)=>show(m,'info',d), warning:(m,d)=>show(m,'warning',d) };
    })();

    const Dialog = (function () {
      let lastFocused = null, current = null;
      function open(opts) {
        close();
        lastFocused = document.activeElement;
        const id = uid();
        const backdrop = document.createElement('div');
        backdrop.className = 'dialog-backdrop';
        backdrop.innerHTML =
          '<div class="dialog" role="dialog" aria-modal="true" aria-labelledby="'+id+'_title">'+
            '<h3 id="'+id+'_title">'+escapeHtml(opts.title || 'تأیید عملیات')+'</h3>'+
            '<p>'+(opts.bodyHtml || '')+'</p>'+
            (opts.showCheckbox ? '<label class="check-row"><input type="checkbox" id="'+id+'_chk" /> '+escapeHtml(opts.checkboxLabel || '')+'</label>' : '')+
            '<div class="dialog-actions">'+
              '<button class="btn" data-action="cancel">'+escapeHtml(opts.cancelLabel || 'انصراف')+'</button>'+
              '<button class="btn '+(opts.danger?'danger':'primary')+'" data-action="confirm">'+escapeHtml(opts.confirmLabel || 'تأیید')+'</button>'+
            '</div>'+
          '</div>';
        $('#dialogMount').appendChild(backdrop);
        current = backdrop;
        const confirmBtn = $('[data-action="confirm"]', backdrop);
        const cancelBtn = $('[data-action="cancel"]', backdrop);
        const checkbox = opts.showCheckbox ? $('#'+id+'_chk', backdrop) : null;
        function finish(ok) {
          const checked = checkbox ? checkbox.checked : false;
          close();
          if (ok && typeof opts.onConfirm === 'function') opts.onConfirm(checked);
        }
        confirmBtn.addEventListener('click', ()=>finish(true));
        cancelBtn.addEventListener('click', ()=>finish(false));
        backdrop.addEventListener('click', (e)=>{ if (e.target === backdrop) finish(false); });
        backdrop.addEventListener('keydown', (e)=>{
          if (e.key === 'Escape') { e.preventDefault(); finish(false); }
          if (e.key === 'Enter' && document.activeElement !== cancelBtn) { e.preventDefault(); finish(true); }
          if (e.key === 'Tab') {
            const f = [cancelBtn, confirmBtn]; if (checkbox) f.unshift(checkbox);
            const i = f.indexOf(document.activeElement); e.preventDefault();
            (e.shiftKey ? f[(i-1+f.length)%f.length] : f[(i+1)%f.length]).focus();
          }
        });
        setTimeout(()=>confirmBtn.focus(), 0);
      }
      function close() {
        if (current) { current.remove(); current = null; }
        if (lastFocused && typeof lastFocused.focus === 'function') { try { lastFocused.focus(); } catch(e){} }
      }
      return { open, close };
    })();

    /* ═══════════════ CHART SETUP ═══════════════ */
    const ChartSetup = (function () {
      const store = new Map();
      function getChartCssVars() {
        const cs = getComputedStyle(document.documentElement);
        const g = (k, fb) => cs.getPropertyValue(k).trim() || fb;
        return {
          tip: g('--tip','#131318'), separator: g('--separator','#26262F'),
          label: g('--label','#EDEDF0'), label2: g('--label-2','#A0A0AC'),
          accent: g('--accent','#6366F1'),
        };
      }
      const centerTextPlugin = {
        id: 'centerText',
        afterDraw(chart, args, options) {
          if (!options || !options.text) return;
          const { ctx, chartArea } = chart;
          if (!chartArea) return;
          const x = (chartArea.left + chartArea.right) / 2;
          const y = (chartArea.top + chartArea.bottom) / 2;
          ctx.save();
          ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
          const cv = getChartCssVars();
          ctx.fillStyle = cv.label;
          ctx.font = '700 20px Vazirmatn, Tahoma, sans-serif';
          ctx.fillText(options.text, x, y - 6);
          if (options.label) {
            ctx.fillStyle = cv.label2;
            ctx.font = '400 11px Vazirmatn, Tahoma, sans-serif';
            ctx.fillText(options.label, x, y + 14);
          }
          ctx.restore();
        }
      };
      function makeTooltip() {
        const cv = getChartCssVars();
        return {
          backgroundColor: cv.tip, titleColor: cv.label, bodyColor: cv.label2,
          borderColor: cv.separator, borderWidth: 1, padding: 10, cornerRadius: 8,
          rtl: true, textDirection: 'rtl',
          titleFont: { family:'Vazirmatn, Tahoma, sans-serif', size:12, weight:'700' },
          bodyFont: { family:'Vazirmatn, Tahoma, sans-serif', size:12 },
          displayColors: true,
          callbacks: { label(ctx) {
            const l = ctx.dataset && ctx.dataset.label ? ctx.dataset.label : '';
            return (l ? l + ': ' : '') + toFa(ctx.formattedValue);
          }}
        };
      }
      const defaultOptions = (overrides = {}) => {
        const cv = getChartCssVars();
        return {
          responsive: true, maintainAspectRatio: false,
          animation: { duration: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 400 },
          plugins: {
            legend: { position:'bottom', rtl:true, labels:{ color:cv.label2, font:{family:'Vazirmatn, Tahoma, sans-serif', size:11}, usePointStyle:true, pointStyle:'circle', boxWidth:8, padding:12 } },
            tooltip: makeTooltip(),
          },
          ...overrides,
        };
      };
      const PALETTE = ['#6366F1','#22C55E','#F59E0B','#EF4444','#3B82F6','#A855F7','#14B8A6','#EC4899','#8B5CF6','#0EA5E9'];
      function destroy(id) {
        if (store.has(id)) { try { store.get(id).destroy(); } catch(e){} store.delete(id); }
      }
      function register(id, config) {
        destroy(id);
        const canvas = document.getElementById(id);
        if (!canvas) return null;
        const chart = new Chart(canvas, config);
        store.set(id, chart);
        return chart;
      }
      function destroyAll() { store.forEach(c=>{try{c.destroy();}catch(e){}}); store.clear(); }
      return { getChartCssVars, centerTextPlugin, makeTooltip, defaultOptions, PALETTE, register, destroy, destroyAll };
    })();

    /* ═══════════════ STATE (declared BEFORE Users uses it) ═══════════════ */
    const State = {
      selectedUserId: null,
      selectedUser: null,
      userDetail: null,
      activeTab: 'overview',
      filesFilter: 'all',
      chatSessionId: null,
      chatMessages: [],
      chatStatus: '',
      psyData: null,
      psyLoading: false,
      customKpis: [],
      drilldownTopic: null,
      _autoRefreshTimer: null,

      selectUser(userId) {
        this.selectedUserId = userId;
        this.activeTab = 'overview';
        this.userDetail = null;
        this.filesFilter = 'all';
        this.chatSessionId = null;
        this.chatMessages = [];
        this.psyData = null;
        this.drilldownTopic = null;
        this.customKpis = CustomKPI.load(userId);
        Router.sync();
        Users.updateActive();
        this.loadUserDetail();
      },

      async loadUserDetail() {
        const id = this.selectedUserId;
        if (!id) return;
        const inner = $('#mainInner');
        inner.innerHTML = '<div class="empty-block" style="min-height:200px"><div class="spinner" style="margin:0 auto"></div></div>';
        try {
          const data = await apiFetch('/api/behavior-analysis/' + encodeURIComponent(id) + '/');
          if (!data || !data.success) throw new Error('پاسخ نامعتبر');
          if (this.selectedUserId !== id) return;
          this.userDetail = data;
          this.selectedUser = data.user || { id, username: 'کاربر ' + toFa(id) };
          this.renderDashboard();
        } catch (err) {
          if (this.selectedUserId !== id) return;
          inner.innerHTML = '<div class="empty-block"><div class="big">⚠️</div><h3>خطا در بارگذاری</h3><p>'+escapeHtml(err.message || 'مشکلی پیش آمد')+'</p></div>';
          Toast.error('خطا در دریافت تحلیل کاربر');
        }
      },

      renderDashboard() {
        const u = this.selectedUser || {};
        const detail = this.userDetail || {};
        const files = (detail.files || []).map(pickFile);
        const behavior = detail.behavior || {};
        const totalFiles = files.length || Number(behavior.total_files || 0) || 0;
        const relatedCount = files.filter(f => f.related).length;
        const unrelatedCount = totalFiles - relatedCount;
        const suspiciousCount = files.filter(f => f.suspicious).length;
        const relScores = files.map(f => f.rel).filter(n => !isNaN(n));
        const avgRel = relScores.length ? relScores.reduce((a,b)=>a+b,0) / relScores.length : 0;

        const inner = $('#mainInner');
        inner.innerHTML = '';

        const uhead = document.createElement('div');
        uhead.className = 'card uhead section-gap';
        uhead.innerHTML =
          '<span class="avatar" style="'+avatarStyle(u.id)+'">'+escapeHtml(initialsOf(u.username))+'</span>'+
          '<div class="uhead-main">'+
            '<div class="uhead-name">'+escapeHtml(u.username || 'کاربر '+toFa(u.id))+'</div>'+
            '<div class="uhead-sub">'+toFa(totalFiles)+' فایل تحلیل‌شده · میانگین relevance '+fmtRel(avgRel)+'</div>'+
          '</div>'+
          '<button class="icon-btn" aria-label="گزینه‌های بیشتر" id="userMoreBtn">⋯</button>';
        inner.appendChild(uhead);

        const kpiStrip = document.createElement('div');
        kpiStrip.className = 'card kpi-strip section-gap';
        kpiStrip.id = 'kpiStrip';
        inner.appendChild(kpiStrip);
        this.renderKpis(totalFiles, relatedCount, unrelatedCount, suspiciousCount, avgRel);

        const tabs = [
          { key:'overview', label:'نمای کلی', badge:null },
          { key:'files', label:'فایل‌ها', badge:totalFiles },
          { key:'chat', label:'چت با AI', badge:null },
          { key:'psychology', label:'روانشناسی', badge:null },
        ];
        const tabbar = document.createElement('div');
        tabbar.className = 'tabbar';
        tabbar.setAttribute('role','tablist');
        tabbar.setAttribute('aria-label','بخش‌های داشبورد');
        tabbar.innerHTML = tabs.map(t =>
          '<button class="tab'+(this.activeTab===t.key?' active':'')+'" role="tab" id="tab_'+t.key+'" data-tab="'+t.key+'" aria-selected="'+(this.activeTab===t.key)+'" aria-controls="panel_'+t.key+'">'+
            escapeHtml(t.label)+(t.badge!==null?' <span class="badge">'+toFa(t.badge)+'</span>':'')+
          '</button>'
        ).join('');
        inner.appendChild(tabbar);

        const panelHost = document.createElement('div');
        panelHost.id = 'panelHost';
        inner.appendChild(panelHost);

        const overviewPanel = document.createElement('div');
        overviewPanel.className = 'panel'+(this.activeTab==='overview'?' active':'');
        overviewPanel.id = 'panel_overview';
        overviewPanel.setAttribute('role','tabpanel');
        overviewPanel.setAttribute('aria-labelledby','tab_overview');
        overviewPanel.innerHTML = '<div class="chart-grid" id="chartGrid">'+
          '<div class="card chart-card"><h4>توزیع موضوعی <span class="hint">برای جزئیات کلیک کنید</span></h4><div class="chart-box" id="chartTopicBox"></div></div>'+
          '<div class="card chart-card"><h4>نوع فایل</h4><div class="chart-box" id="chartKindBox"></div></div>'+
          '<div class="card chart-card"><h4>ماتریس سازمانی / غیرسازمانی</h4><div class="chart-box" id="chartMatrixBox"></div></div>'+
          '<div class="card chart-card"><h4>فعالیت روزانه و هم‌راستایی نقش</h4><div class="chart-box" id="chartTrendBox"></div></div>'+
        '</div><div id="drilldownMount"></div>';
        panelHost.appendChild(overviewPanel);

        const filesPanel = document.createElement('div');
        filesPanel.className = 'panel'+(this.activeTab==='files'?' active':'');
        filesPanel.id = 'panel_files';
        filesPanel.setAttribute('role','tabpanel');
        filesPanel.setAttribute('aria-labelledby','tab_files');
        filesPanel.innerHTML = '<div id="filesMount"></div>';
        panelHost.appendChild(filesPanel);

        const chatPanel = document.createElement('div');
        chatPanel.className = 'panel'+(this.activeTab==='chat'?' active':'');
        chatPanel.id = 'panel_chat';
        chatPanel.setAttribute('role','tabpanel');
        chatPanel.setAttribute('aria-labelledby','tab_chat');
        chatPanel.innerHTML = '<div id="chatMount"></div>';
        panelHost.appendChild(chatPanel);

        const psyPanel = document.createElement('div');
        psyPanel.className = 'panel'+(this.activeTab==='psychology'?' active':'');
        psyPanel.id = 'panel_psychology';
        psyPanel.setAttribute('role','tabpanel');
        psyPanel.setAttribute('aria-labelledby','tab_psychology');
        psyPanel.innerHTML = '<div id="psyMount"></div>';
        panelHost.appendChild(psyPanel);

        $$('.tab', tabbar).forEach(tabEl => {
          tabEl.addEventListener('click', () => this.switchTab(tabEl.getAttribute('data-tab')));
        });
        tabbar.addEventListener('keydown', (e) => {
          const els = $$('.tab', tabbar);
          const i = els.indexOf(document.activeElement);
          if (i < 0) return;
          let n = null;
          if (e.key === 'ArrowLeft') n = els[(i+1)%els.length];
          if (e.key === 'ArrowRight') n = els[(i-1+els.length)%els.length];
          if (e.key === 'Home') n = els[0];
          if (e.key === 'End') n = els[els.length-1];
          if (n) { e.preventDefault(); n.focus(); this.switchTab(n.getAttribute('data-tab')); }
        });

        $('#headerUserChip').classList.add('visible');
        $('#headerUserAvatar').style.cssText = avatarStyle(u.id);
        $('#headerUserAvatar').textContent = initialsOf(u.username);
        $('#headerUserName').textContent = u.username || '';

        if (this.activeTab === 'overview') setTimeout(()=>this.renderOverviewCharts(), 0);
        else if (this.activeTab === 'files') this.renderFiles();
        else if (this.activeTab === 'chat') this.renderChat();
        else if (this.activeTab === 'psychology') this.renderPsychology();
      },

      switchTab(key) {
        if (this.activeTab === key) return;
        this.activeTab = key;
        $$('.tab').forEach(el => {
          const on = el.getAttribute('data-tab') === key;
          el.classList.toggle('active', on);
          el.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        $$('.panel').forEach(el => el.classList.toggle('active', el.id === 'panel_'+key));
        Router.sync();

        if (key === 'overview') this.renderOverviewCharts();
        else if (key === 'files') this.renderFiles();
        else if (key === 'chat') this.renderChat();
        else if (key === 'psychology') this.renderPsychology();
      },

      renderKpis(total, related, unrelated, suspicious, avgRel) {
        const strip = $('#kpiStrip');
        if (!strip) return;
        const base = [
          { label:'کل فایل‌ها', value:toFa(total), color:'var(--text)' },
          { label:'مرتبط', value:toFa(related), color:'var(--green)' },
          { label:'غیرمرتبط', value:toFa(unrelated), color:'var(--red)' },
          { label:'مشکوک', value:toFa(suspicious), color:'var(--orange)' },
          { label:'میانگین relevance', value:fmtRel(avgRel), color:'var(--accent)' },
        ];
        const custom = this.customKpis || [];
        strip.innerHTML =
          base.map(c => '<div class="kpi-cell"><div class="kpi-value" style="color:'+c.color+'">'+c.value+'</div><div class="kpi-label">'+c.label+'</div></div>').join('')+
          custom.map(c =>
            '<div class="kpi-cell kpi-custom" data-kpi-id="'+escapeHtml(c.id)+'">'+
              '<div class="kpi-value" style="color:var(--accent)">'+this.computeCustomKpi(c.formula)+'</div>'+
              '<div class="kpi-label">'+escapeHtml(c.label)+'</div>'+
              '<button class="kpi-remove" data-remove-kpi="'+escapeHtml(c.id)+'" aria-label="حذف شاخص">✕</button>'+
            '</div>'
          ).join('')+
          '<button class="kpi-add" id="addKpiBtn" aria-label="افزودن شاخص سفارشی">+</button>';

        const addBtn = $('#addKpiBtn', strip);
        if (addBtn) addBtn.addEventListener('click', ()=>CustomKPI.openDrawer());
        $$('[data-remove-kpi]', strip).forEach(btn => {
          btn.addEventListener('click', (e)=>{
            e.stopPropagation();
            CustomKPI.remove(btn.getAttribute('data-remove-kpi'));
          });
        });
      },

      computeCustomKpi(formula) {
        const detail = this.userDetail || {};
        const files = (detail.files || []).map(pickFile);
        const total = files.length;
        const related = files.filter(f => f.related).length;
        const unrelated = total - related;
        const suspicious = files.filter(f => f.suspicious).length;
        const relScores = files.map(f => f.rel).filter(n=>!isNaN(n));
        const avgRel = relScores.length ? relScores.reduce((a,b)=>a+b,0)/relScores.length : 0;
        const topics = (detail.topic_distribution || []).length;
        const org = files.filter(f => f.org).length;
        switch (formula) {
          case 'total': return toFa(total);
          case 'related': return toFa(related);
          case 'unrelated': return toFa(unrelated);
          case 'suspicious': return toFa(suspicious);
          case 'relevance': return fmtRel(avgRel);
          case 'related_pct': return fmtRel(total ? related/total : 0);
          case 'susp_pct': return fmtRel(total ? suspicious/total : 0);
          case 'topics_count': return toFa(topics);
          case 'org_count': return toFa(org);
          default: return '—';
        }
      },
    };

    /* ═══════════════ USERS ═══════════════ */
    const Users = (function () {
      let allUsers = [], filterText = '', loading = true;
      function renderSkeleton() {
        const list = $('#userList');
        list.innerHTML = '';
        for (let i=0;i<3;i++) {
          const r = document.createElement('div');
          r.className = 'skeleton-row';
          r.innerHTML = '<div class="sk sk-avatar"></div><div class="sk-lines"><div class="sk sk-line-1"></div><div class="sk sk-line-2"></div></div>';
          list.appendChild(r);
        }
      }
      function renderEmpty() {
        $('#userList').innerHTML = '<div class="empty-side"><span class="big">👥</span>هیچ کاربری یافت نشد</div>';
      }
      function render() {
        const list = $('#userList');
        const q = filterText.trim().toLowerCase();
        const filtered = allUsers.filter(u => !q || String(u.username||'').toLowerCase().includes(q) || String(u.user_id).includes(q));
        if (loading) { renderSkeleton(); return; }
        if (!filtered.length) { renderEmpty(); return; }
        list.innerHTML = '';
        filtered.forEach(u => {
          const item = document.createElement('button');
          item.className = 'user-item';
          item.setAttribute('role','option');
          item.setAttribute('data-user-id', u.user_id);
          item.setAttribute('aria-selected', State.selectedUserId === u.user_id ? 'true' : 'false');
          if (State.selectedUserId === u.user_id) item.classList.add('active');
          item.innerHTML =
            '<span class="avatar" style="'+avatarStyle(u.user_id)+'">'+escapeHtml(initialsOf(u.username))+'</span>'+
            '<div class="user-meta">'+
              '<div class="user-name">'+escapeHtml(u.username || 'کاربر '+toFa(u.user_id))+'</div>'+
              '<div class="user-sub">'+toFa(u.total_files ?? 0)+' فایل · '+fmtRel(u.related_percent ?? 0)+' مرتبط</div>'+
            '</div>';
          item.addEventListener('click', () => {
            if (State.selectedUserId !== u.user_id) State.selectUser(u.user_id);
          });
          list.appendChild(item);
        });
      }
      async function fetchUsers() {
        loading = true; render();
        try {
          const data = await apiFetch('/api/behavior-analysis/');
          allUsers = (data && data.success && Array.isArray(data.items)) ? data.items : [];
        } catch (err) {
          allUsers = []; Toast.error('خطا در دریافت لیست کاربران');
        } finally {
          loading = false;
          $('#userCountBadge').textContent = toFa(allUsers.length);
          render();
        }
      }
      function setFilter(t) { filterText = t; render(); }
      function updateActive() {
        $$('.user-item', $('#userList')).forEach(el => {
          const id = Number(el.getAttribute('data-user-id'));
          const on = State.selectedUserId === id;
          el.classList.toggle('active', on);
          el.setAttribute('aria-selected', on ? 'true' : 'false');
        });
      }
      return { fetchUsers, render, setFilter, updateActive };
    })();

    /* ═══════════════ OVERVIEW CHARTS ═══════════════ */
    State.renderOverviewCharts = function () {
      const topicBox = $('#chartTopicBox');
      const kindBox = $('#chartKindBox');
      const matrixBox = $('#chartMatrixBox');
      const trendBox = $('#chartTrendBox');
      if (!topicBox || !kindBox || !matrixBox || !trendBox) return;
      ChartSetup.destroyAll();
      this.renderTopicChart(topicBox);
      this.renderKindChart(kindBox);
      this.renderMatrixChart(matrixBox);
      this.renderTrendChart(trendBox);
      this.renderDrilldown();
    };

    State.renderTopicChart = function (host) {
      const detail = this.userDetail || {};
      const dist = Array.isArray(detail.topic_distribution) ? detail.topic_distribution : [];
      // normalize topic objects
      const topics = dist
        .map(t => ({
          name: t.name || t.topic || t.topic_name || t.label || 'بدون نام',
          count: Number(t.count ?? t.total ?? (Array.isArray(t.files) ? t.files.length : 0)) || 0,
          files: Array.isArray(t.files) ? t.files.map(pickTopicFile) : [],
        }))
        .filter(t => t.count > 0);
      host.innerHTML = '';
      if (!topics.length) { host.innerHTML = '<div class="no-data">داده‌ای موجود نیست</div>'; return; }
      const box = document.createElement('div');
      box.className = 'chart-box';
      const canvasId = 'canvas_topic_'+uid();
      box.innerHTML = '<canvas id="'+canvasId+'"></canvas>';
      host.appendChild(box);
      const total = topics.reduce((a,t)=>a+t.count,0);
      const labels = topics.map(t=>t.name);
      const values = topics.map(t=>t.count);
      const colors = ChartSetup.PALETTE.slice(0, labels.length);
      const config = {
        type: 'doughnut',
        data: { labels, datasets: [{ data: values, backgroundColor: colors, borderColor:'transparent', borderWidth: 2, hoverOffset: 6 }] },
        options: ChartSetup.defaultOptions({
          cutout: '68%',
          plugins: {
            ...ChartSetup.defaultOptions().plugins,
            legend: { display: false },
            centerText: { text: toFa(total), label: 'Topics' },
            tooltip: ChartSetup.makeTooltip(),
          },
          onClick: (evt, elements) => {
            if (!elements || !elements.length) return;
            const topic = topics[elements[0].index];
            if (!topic) return;
            State.drilldownTopic = topic;
            State.renderDrilldown();
            // scroll drilldown into view
            setTimeout(()=>{
              const dd = $('#drilldownMount');
              if (dd && dd.scrollIntoView) dd.scrollIntoView({ behavior:'smooth', block:'nearest' });
            }, 30);
          },
        }),
        plugins: [ChartSetup.centerTextPlugin],
      };
      ChartSetup.register(canvasId, config);
      // validate stored drilldown against current topics
      if (State.drilldownTopic) {
        const found = topics.find(t => t.name === State.drilldownTopic.name);
        if (found) State.drilldownTopic = found;
        else State.drilldownTopic = null;
      }
    };

    State.renderKindChart = function (host) {
      const dist = this.userDetail?.kind_distribution || {};
      const keys = Object.keys(dist).filter(k => Number(dist[k]) > 0);
      host.innerHTML = '';
      if (!keys.length) { host.innerHTML = '<div class="no-data">داده‌ای موجود نیست</div>'; return; }
      const box = document.createElement('div');
      box.className = 'chart-box';
      const canvasId = 'canvas_kind_'+uid();
      box.innerHTML = '<canvas id="'+canvasId+'"></canvas>';
      host.appendChild(box);
      const total = keys.reduce((a,k)=>a+Number(dist[k]||0),0);
      const MAP = { pdf:'PDF', docx:'DOCX', xlsx:'XLSX', pptx:'PPTX', txt:'TXT', image:'تصویر', jpg:'تصویر', png:'تصویر', other:'سایر' };
      const labels = keys.map(k => MAP[String(k).toLowerCase()] || k);
      const values = keys.map(k => Number(dist[k]||0));
      const colors = ChartSetup.PALETTE.slice(0, labels.length);
      const config = {
        type: 'doughnut',
        data: { labels, datasets: [{ data: values, backgroundColor: colors, borderColor:'transparent', borderWidth: 2, hoverOffset: 6 }] },
        options: ChartSetup.defaultOptions({
          cutout: '68%',
          plugins: {
            ...ChartSetup.defaultOptions().plugins,
            legend: { display: false },
            centerText: { text: toFa(total), label: 'Files' },
          },
        }),
        plugins: [ChartSetup.centerTextPlugin],
      };
      ChartSetup.register(canvasId, config);
    };

    State.renderMatrixChart = function (host) {
      const m = this.userDetail?.matrix_2x2 || {};
      let labels, values;
      if (Array.isArray(m.categories) && Array.isArray(m.values)) {
        labels = m.categories;
        values = m.values;
      } else {
        labels = ['سازمانی · مرتبط', 'سازمانی · غیرمرتبط', 'غیرسازمانی · مرتبط', 'غیرسازمانی · غیرمرتبط'];
        values = [
          Number(m.org_related ?? m.orgRelated ?? 0),
          Number(m.org_unrelated ?? m.orgUnrelated ?? 0),
          Number(m.nonorg_related ?? m.nonOrgRelated ?? 0),
          Number(m.nonorg_unrelated ?? m.nonOrgUnrelated ?? 0),
        ];
      }
      host.innerHTML = '';
      if (!values.some(v => Number(v) > 0)) { host.innerHTML = '<div class="no-data">داده‌ای موجود نیست</div>'; return; }
      const box = document.createElement('div');
      box.className = 'chart-box';
      const canvasId = 'canvas_matrix_'+uid();
      box.innerHTML = '<canvas id="'+canvasId+'"></canvas>';
      host.appendChild(box);
      const cv = ChartSetup.getChartCssVars();
      const config = {
        type: 'bar',
        data: { labels, datasets: [{ data: values.map(v=>Number(v)||0), backgroundColor: ['#6366F1','#EF4444','#22C55E','#F59E0B'], borderRadius: 6, barThickness: 18 }] },
        options: ChartSetup.defaultOptions({
          indexAxis: 'y',
          scales: {
            x: { beginAtZero: true, grid:{ color: cv.separator, drawBorder:false }, ticks:{ color: cv.label2, font:{family:'Vazirmatn, Tahoma, sans-serif', size:10}, callback:v=>toFa(v) } },
            y: { grid:{ display:false }, ticks:{ color: cv.label2, font:{family:'Vazirmatn, Tahoma, sans-serif', size:11} } },
          },
          plugins: { ...ChartSetup.defaultOptions().plugins, legend: { display: false } },
        }),
      };
      ChartSetup.register(canvasId, config);
    };

    /* FIX bug 3: normalize trend + guard NaN */
    State.renderTrendChart = function (host) {
      const raw = Array.isArray(this.userDetail?.trend) ? this.userDetail.trend : [];
      const trend = raw.map(pickTrendPoint).filter(p => p.label !== '' || p.related || p.unrelated);
      host.innerHTML = '';
      if (!trend.length) { host.innerHTML = '<div class="no-data">داده‌ای موجود نیست</div>'; return; }
      const box = document.createElement('div');
      box.className = 'chart-box';
      const canvasId = 'canvas_trend_'+uid();
      box.innerHTML = '<canvas id="'+canvasId+'"></canvas>';
      host.appendChild(box);
      const cv = ChartSetup.getChartCssVars();
      const labels = trend.map(t => t.label || '');
      const bars1 = trend.map(t => t.related);
      const bars2 = trend.map(t => t.unrelated);
      const line = trend.map(t => t.alignment === null ? null : t.alignment);
      const config = {
        type: 'bar',
        data: {
          labels,
          datasets: [
            { type:'bar', label:'مرتبط', data: bars1, backgroundColor:'#22C55E', borderRadius:4, order:2, yAxisID:'y' },
            { type:'bar', label:'غیرمرتبط', data: bars2, backgroundColor:'#EF4444', borderRadius:4, order:2, yAxisID:'y' },
            { type:'line', label:'هم‌راستایی نقش', data: line, borderColor:'#6366F1', backgroundColor:'rgba(99,102,241,.2)', tension:.35, borderWidth:2, pointRadius:2, order:1, yAxisID:'y2', spanGaps:true },
          ]
        },
        options: ChartSetup.defaultOptions({
          scales: {
            x: { grid:{ display:false }, ticks:{ color: cv.label2, font:{family:'Vazirmatn, Tahoma, sans-serif', size:10} } },
            y: { beginAtZero:true, position:'right', grid:{ color: cv.separator }, ticks:{ color: cv.label2, font:{family:'Vazirmatn, Tahoma, sans-serif', size:10}, callback:v=>toFa(v) } },
            y2: { beginAtZero:true, max:100, position:'left', grid:{ display:false }, ticks:{ color: cv.label2, font:{family:'Vazirmatn, Tahoma, sans-serif', size:10}, callback:v=>toFa(v)+'٪' } },
          },
          plugins: {
            ...ChartSetup.defaultOptions().plugins,
            legend: { position:'bottom', rtl:true, labels:{ color: cv.label2, font:{family:'Vazirmatn, Tahoma, sans-serif', size:11}, usePointStyle:true, boxWidth:8 } },
          },
        }),
      };
      ChartSetup.register(canvasId, config);
    };

    /* FIX bug 2: drilldown tolerates empty files gracefully + always shows stats */
    State.renderDrilldown = function () {
      const mount = $('#drilldownMount');
      if (!mount) return;
      const topic = this.drilldownTopic;
      if (!topic) { mount.innerHTML = ''; return; }
      const files = Array.isArray(topic.files) ? topic.files : [];
      const related = files.filter(f => f.related).length;
      const relScores = files.map(f => f.rel).filter(n=>!isNaN(n));
      const avgRel = relScores.length ? relScores.reduce((a,b)=>a+b,0)/relScores.length : 0;

      const fileList = files.length
        ? '<div class="drill-files" style="margin-top:12px">' +
            files.map(f =>
              '<div class="drill-file">'+
                '<span class="fname" title="'+escapeHtml(f.name)+'">'+escapeHtml(f.name || '—')+'</span>'+
                '<span class="frelevance">'+fmtRel(f.rel)+'</span>'+
              '</div>'
            ).join('') +
          '</div>'
        : '<div class="no-data" style="min-height:80px;margin-top:12px">فایلی برای این موضوع ثبت نشده است</div>';

      mount.innerHTML =
        '<div class="drilldown">'+
          '<div class="drill-head">'+
            '<button class="btn" id="drillBackBtn">'+svgIcon('back')+' بازگشت به نمودارها</button>'+
            '<span class="drill-title">موضوع: '+escapeHtml(topic.name || '—')+'</span>'+
          '</div>'+
          '<div class="drill-stats">'+
            '<div class="drill-stat"><b>'+toFa(topic.count ?? files.length)+'</b><span>تعداد فایل</span></div>'+
            '<div class="drill-stat"><b style="color:var(--green)">'+toFa(related)+'</b><span>مرتبط</span></div>'+
            '<div class="drill-stat"><b style="color:var(--accent)">'+fmtRel(avgRel)+'</b><span>میانگین relevance</span></div>'+
          '</div>'+
          fileList+
        '</div>';

      const back = $('#drillBackBtn', mount);
      if (back) back.addEventListener('click', ()=>{ State.drilldownTopic = null; State.renderDrilldown(); });
    };

    /* FIX bug 1: files table uses normalized pickFile */
    State.renderFiles = function () {
      const mount = $('#filesMount');
      if (!mount) return;
      const files = (this.userDetail?.files || []).map(pickFile);
      const total = files.length;
      const related = files.filter(f=>f.related).length;
      const unrelated = total - related;
      const suspicious = files.filter(f=>f.suspicious).length;

      let filtered = files;
      if (this.filesFilter === 'related') filtered = files.filter(f=>f.related);
      else if (this.filesFilter === 'unrelated') filtered = files.filter(f=>!f.related);
      else if (this.filesFilter === 'suspicious') filtered = files.filter(f=>f.suspicious);

      mount.innerHTML =
        '<div class="chips" role="group" aria-label="فیلتر فایل‌ها">'+
          '<button class="chip'+(this.filesFilter==='all'?' active':'')+'" data-filter="all">همه <span class="n">'+toFa(total)+'</span></button>'+
          '<button class="chip'+(this.filesFilter==='related'?' active':'')+'" data-filter="related">مرتبط <span class="n">'+toFa(related)+'</span></button>'+
          '<button class="chip'+(this.filesFilter==='unrelated'?' active':'')+'" data-filter="unrelated">غیرمرتبط <span class="n">'+toFa(unrelated)+'</span></button>'+
          '<button class="chip'+(this.filesFilter==='suspicious'?' active':'')+'" data-filter="suspicious">مشکوک <span class="n">'+toFa(suspicious)+'</span></button>'+
        '</div>'+
        '<div class="table-wrap">'+
          '<table class="files">'+
            '<thead><tr><th>فایل</th><th class="col-topic">موضوع</th><th>وضعیت</th><th>relevance</th></tr></thead>'+
            '<tbody>'+
              (filtered.length
                ? filtered.map(f => {
                    return '<tr>'+
                      '<td class="fname-cell"><span class="f" title="'+escapeHtml(f.name)+'">'+escapeHtml(f.name || '—')+'</span></td>'+
                      '<td class="col-topic">'+escapeHtml(f.topic || '—')+'</td>'+
                      '<td>'+
                        (f.related ? '<span class="pill ok">مرتبط</span>' : '<span class="pill bad">غیرمرتبط</span>')+
                        (f.suspicious ? ' <span class="pill warn">مشکوک</span>' : '')+
                      '</td>'+
                      '<td><div class="scorebar"><div class="track"><div class="fill" data-score="'+clamp01(f.rel)+'"></div></div><span class="val">'+fmtRel(f.rel)+'</span></div></td>'+
                    '</tr>';
                  }).join('')
                : '<tr><td colspan="4"><div class="no-data" style="border:none;min-height:120px">داده‌ای موجود نیست</div></td></tr>')+
            '</tbody>'+
          '</table>'+
        '</div>';

      $$('.chip', mount).forEach(chip => {
        chip.addEventListener('click', ()=>{
          State.filesFilter = chip.getAttribute('data-filter');
          State.renderFiles();
        });
      });
      requestAnimationFrame(()=>{
        $$('.scorebar .fill', mount).forEach(el=>{
          const t = Number(el.getAttribute('data-score')) || 0;
          el.style.width = (t*100)+'%';
        });
      });
    };

    /* ═══════════════ CHAT ═══════════════ */
    State.renderChat = function () {
      const mount = $('#chatMount');
      if (!mount) return;
      const session = this.chatSessionId;
      mount.innerHTML =
        '<div class="chat-toolbar">'+
          '<button class="btn primary" id="newChatBtn">جلسه جدید</button>'+
          '<input class="input-text" id="imageTopicInput" placeholder="موضوع تصویر (اختیاری)…" aria-label="موضوع تصویر" />'+
          '<button class="btn" id="genImageBtn"'+(!session?' disabled':'')+'>تولید تصویر</button>'+
          '<span class="chat-status" id="chatStatusText">'+escapeHtml(this.chatStatus || (session ? 'جلسه فعال' : 'بدون جلسه'))+'</span>'+
        '</div>'+
        '<div class="chat-shell">'+
          '<div class="chat-messages" id="chatMessages" aria-live="polite">'+
            (this.chatMessages.length
              ? this.chatMessages.map(m=>this.renderMessage(m)).join('')
              : '<div class="chat-empty"><span class="big">💬</span><div>هنوز پیامی ارسال نشده است.<br/>برای شروع، روی «جلسه جدید» بزنید و سپس سؤال خود را بنویسید.</div></div>')+
            '<div id="imgResultMount"></div>'+
          '</div>'+
          '<div class="chat-input-row">'+
            '<textarea id="chatInput" rows="1" placeholder="سؤال خود را بنویسید… (Enter برای ارسال، Shift+Enter برای خط جدید)" aria-label="ورودی چت"></textarea>'+
            '<button class="btn primary" id="sendChatBtn">ارسال</button>'+
          '</div>'+
        '</div>';

      $('#newChatBtn', mount).addEventListener('click', ()=>Chat.startSession());
      $('#genImageBtn', mount).addEventListener('click', ()=>Chat.generateImage());
      $('#sendChatBtn', mount).addEventListener('click', ()=>Chat.sendMessage());
      const input = $('#chatInput', mount);
      if (input) {
        input.addEventListener('keydown', (e)=>{
          if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); Chat.sendMessage(); }
        });
        input.addEventListener('input', ()=>{
          input.style.height = 'auto';
          input.style.height = Math.min(input.scrollHeight, 150) + 'px';
        });
      }
      this.scrollChatToBottom();
    };

    State.renderMessage = function (m) {
      const isUser = m.role === 'user';
      const style = isUser ? 'style="'+avatarStyle(State.selectedUserId)+'"' : 'style="background:linear-gradient(135deg,#6366F1,#A855F7);"';
      const text = isUser ? initialsOf(State.selectedUser?.username || 'شما') : 'AI';
      return '<div class="msg '+(isUser?'user':'assistant')+'">'+
        '<span class="avatar" '+style+'>'+escapeHtml(text)+'</span>'+
        '<div class="bubble">'+escapeHtml(m.content)+'<span class="msg-time">'+(m.time || nowTimeFa())+'</span></div>'+
      '</div>';
    };

    State.scrollChatToBottom = function () {
      const el = $('#chatMessages');
      if (el) el.scrollTop = el.scrollHeight;
    };

    const Chat = (function () {
      function setStatus(text) {
        State.chatStatus = text;
        const el = $('#chatStatusText');
        if (el) el.textContent = text;
      }
      async function startSession() {
        const btn = $('#newChatBtn');
        if (btn) btn.disabled = true;
        setStatus('در حال ایجاد جلسه…');
        try {
          const data = await apiFetch('/api/report-chat/start/', { method:'POST', body: JSON.stringify({ user_id: State.selectedUserId }) });
          if (!data || !data.success) throw new Error((data && data.error) || 'خطا در ایجاد جلسه');
          State.chatSessionId = data.session_id;
          State.chatMessages = [{ role:'assistant', content:'جلسه جدید ایجاد شد. تعداد فایل‌های موجود: '+toFa(data.file_count ?? 0)+'. سؤال خود را بپرسید.', time: nowTimeFa() }];
          setStatus('جلسه فعال · '+toFa(data.file_count ?? 0)+' فایل');
          Toast.success('جلسه جدید ایجاد شد');
          State.renderChat();
        } catch (err) {
          Toast.error(err.message || 'خطا در ایجاد جلسه');
          setStatus('خطا در ایجاد جلسه');
        } finally { if (btn) btn.disabled = false; }
      }
      async function sendMessage() {
        const input = $('#chatInput');
        if (!input) return;
        const text = input.value.trim();
        if (!text) return;
        if (!State.chatSessionId) { Toast.warning('ابتدا یک جلسه جدید ایجاد کنید'); return; }
        input.value = ''; input.style.height = 'auto';
        State.chatMessages.push({ role:'user', content:text, time: nowTimeFa() });
        State.renderChat();

        const messagesEl = $('#chatMessages');
        const typing = document.createElement('div');
        typing.className = 'msg assistant';
        typing.innerHTML = '<span class="avatar" style="background:linear-gradient(135deg,#6366F1,#A855F7);">AI</span><div class="bubble"><span class="typing"><span></span><span></span><span></span></span></div>';
        if (messagesEl) messagesEl.appendChild(typing);
        State.scrollChatToBottom();

        try {
          const data = await apiFetch('/api/report-chat/'+encodeURIComponent(State.chatSessionId)+'/ask/', { method:'POST', body: JSON.stringify({ question: text }) });
          if (!data || !data.success) throw new Error((data && data.error) || 'خطا در دریافت پاسخ');
          State.chatMessages.push({ role:'assistant', content: data.answer || 'پاسخی دریافت نشد', time: nowTimeFa() });
          State.renderChat();
        } catch (err) {
          State.chatMessages.push({ role:'assistant', content: 'خطا: ' + (err.message || 'پاسخ دریافت نشد'), time: nowTimeFa() });
          State.renderChat();
          Toast.error('خطا در ارسال پیام');
        }
      }
      async function generateImage() {
        const topicInput = $('#imageTopicInput');
        const topic = topicInput ? topicInput.value.trim() : '';
        if (!State.chatSessionId) { Toast.warning('ابتدا یک جلسه جدید ایجاد کنید'); return; }
        const btn = $('#genImageBtn');
        if (btn) btn.disabled = true;
        Toast.info('در حال تولید تصویر…');
        try {
          const data = await apiFetch('/api/report-chat/'+encodeURIComponent(State.chatSessionId)+'/generate-image/', { method:'POST', body: JSON.stringify({ topic }) });
          if (!data || !data.success) throw new Error((data && data.error) || 'خطا در تولید تصویر');
          const mount = $('#imgResultMount');
          if (mount) {
            mount.innerHTML = '<div class="img-result">'+
              '<button class="img-close" id="closeImgBtn" aria-label="بستن تصویر">✕</button>'+
              '<img id="genImg" src="data:'+(data.mime_type || 'image/png')+';base64,'+data.image_base64+'" alt="تصویر تولیدشده" />'+
              '<div class="caption">'+escapeHtml(data.image_prompt || 'تصویر تولیدشده')+'</div>'+
            '</div>';
            $('#closeImgBtn', mount).addEventListener('click', ()=>{ mount.innerHTML = ''; });
            const img = $('#genImg', mount);
            if (img) img.addEventListener('click', ()=>openLightbox(img.src));
            State.scrollChatToBottom();
          }
          Toast.success('تصویر تولید شد');
        } catch (err) { Toast.error(err.message || 'خطا در تولید تصویر'); }
        finally { if (btn) btn.disabled = false; }
      }
      return { startSession, sendMessage, generateImage };
    })();

    function openLightbox(src) {
      const lb = document.createElement('div');
      lb.className = 'lightbox';
      lb.innerHTML = '<img src="'+src+'" alt="تصویر بزرگ‌تر" />';
      document.body.appendChild(lb);
      const close = ()=>lb.remove();
      lb.addEventListener('click', close);
      document.addEventListener('keydown', function onKey(e){ if (e.key==='Escape'){ close(); document.removeEventListener('keydown', onKey);} });
    }

    /* ═══════════════ PSYCHOLOGY ═══════════════ */
    State.renderPsychology = function () {
      const mount = $('#psyMount');
      if (!mount) return;
      const data = this.psyData;

      mount.innerHTML =
        '<div class="psy-head">'+
          '<h3 style="margin:0;font-size:15px">تحلیل روانشناختی</h3>'+
          '<div style="display:flex;gap:8px;flex-wrap:wrap">'+
            '<button class="btn" id="psyReanalyzeBtn">تحلیل مجدد</button>'+
            '<button class="btn" id="psyAnalyzeFilesBtn">تحلیل فایل‌ها</button>'+
          '</div>'+
        '</div>'+
        '<div id="psyContent"></div>';

      const content = $('#psyContent', mount);
      if (!data) {
        content.innerHTML = '<div class="empty-block" style="min-height:200px">'+
          '<div class="big">🧠</div><h3>هنوز تحلیلی ذخیره نشده</h3>'+
          '<p>برای دریافت تحلیل روانشناختی، روی «تحلیل مجدد» بزنید.</p></div>';
      } else {
        const risk = clamp01(data.risk_score ?? 0);
        const anomaly = clamp01(data.anomaly_score ?? 0);
        const stress = clamp01(data.stress_index ?? 0);
        const roleFit = clamp01(data.role_fit_score ?? 0);
        const dot = (v, invert=false) => {
          const bad = invert ? (v < .35 ? 'var(--red)' : v < .7 ? 'var(--orange)' : 'var(--green)')
                             : (v >= .7 ? 'var(--red)' : v >= .35 ? 'var(--orange)' : 'var(--green)');
          return bad;
        };
        const cards = [
          { label:'ریسک', value:risk, dot: dot(risk, false) },
          { label:'ناهنجاری', value:anomaly, dot: dot(anomaly, false) },
          { label:'فشار کاری', value:stress, dot: dot(stress, false) },
          { label:'نقش‌پذیری', value:roleFit, dot: dot(roleFit, true) },
        ];
        const signals = Array.isArray(data.signals) ? data.signals : [];
        content.innerHTML =
          '<div class="psy-scores">'+cards.map(c =>
            '<div class="score-card"><div class="lbl"><span class="dot" style="background:'+c.dot+'"></span>'+c.label+'</div><div class="val">'+toFa(Math.round(c.value*100))+'٪</div></div>'
          ).join('')+'</div>'+
          (data.narrative ? '<div class="psy-narrative">'+escapeHtml(data.narrative)+'</div>' : '')+
          (signals.length ? '<div class="signals">'+signals.map(s=>'<span class="signal-pill">'+escapeHtml(s.code || s)+'</span>').join('')+'</div>' : '');
      }

      $('#psyReanalyzeBtn', mount)?.addEventListener('click', ()=>{
        Dialog.open({
          title:'تحلیل مجدد روانشناختی',
          bodyHtml:'این عمل ۱–۳ دقیقه طول می‌کشد. آیا مایل به شروع تحلیل مجدد هستید؟',
          confirmLabel:'شروع تحلیل', cancelLabel:'انصراف',
          onConfirm: ()=>triggerPsychologyAnalysis(),
        });
      });
      $('#psyAnalyzeFilesBtn', mount)?.addEventListener('click', ()=>{
        Dialog.open({
          title:'تحلیل فایل‌ها',
          bodyHtml:'تحلیل فایل‌ها ممکن است چند دقیقه طول بکشد. آیا ادامه می‌دهید؟',
          showCheckbox:true, checkboxLabel:'تحلیل اجباری (حتی اگر قبلاً تحلیل شده باشد)',
          confirmLabel:'شروع تحلیل', cancelLabel:'انصراف',
          onConfirm: (force)=>triggerFilesAnalysis(force),
        });
      });

      if (this.psyLoading) {
        const p = document.createElement('div');
        p.className = 'progress-card';
        p.innerHTML = '<div class="spinner"></div><span>در حال تحلیل… لطفاً صبر کنید.</span>';
        content.appendChild(p);
      }

      // Auto-fetch psychology if not yet loaded
      if (!this.psyData && !this.psyLoading && this.selectedUserId) {
        this.psyLoading = true;
        this.renderPsychology();
        apiFetch('/api/user/'+encodeURIComponent(this.selectedUserId)+'/psychology/')
          .then(res => { if (res && res.ok && res.data) State.psyData = res.data; })
          .catch(()=>{})
          .finally(()=>{
            State.psyLoading = false;
            if (State.selectedUserId && State.activeTab === 'psychology') State.renderPsychology();
          });
      }
    };

    async function triggerPsychologyAnalysis() {
      const id = State.selectedUserId;
      if (!id) return;
      State.psyLoading = true;
      State.renderPsychology();
      try {
        await apiFetch('/api/user/'+encodeURIComponent(id)+'/psychology/', { method:'POST', body: JSON.stringify({}) });
        Toast.info('درخواست ثبت شد؛ نتیجه به‌زودی');
        let attempts = 0;
        const poll = async () => {
          attempts++;
          try {
            const res = await apiFetch('/api/user/'+encodeURIComponent(id)+'/psychology/');
            if (res && res.ok && res.data) {
              State.psyData = res.data;
              State.psyLoading = false;
              if (State.selectedUserId === id && State.activeTab === 'psychology') State.renderPsychology();
              Toast.success('تحلیل روانشناختی به‌روزرسانی شد');
              return;
            }
          } catch(e){}
          if (attempts < 60 && State.selectedUserId === id) setTimeout(poll, 5000);
          else {
            State.psyLoading = false;
            if (State.selectedUserId === id && State.activeTab === 'psychology') State.renderPsychology();
            Toast.warning('نتیجه تحلیل هنوز آماده نیست');
          }
        };
        setTimeout(poll, 5000);
      } catch (err) {
        State.psyLoading = false;
        Toast.error(err.message || 'خطا در شروع تحلیل');
        if (State.selectedUserId === id && State.activeTab === 'psychology') State.renderPsychology();
      }
    }

    async function triggerFilesAnalysis(force) {
      const id = State.selectedUserId;
      if (!id) return;
      try {
        const data = await apiFetch('/api/user/'+encodeURIComponent(id)+'/analyze-files/', { method:'POST', body: JSON.stringify({ force: !!force }) });
        if (data && data.success) {
          Toast.success('درخواست تحلیل فایل‌ها ثبت شد؛ نتیجه به‌زودی');
          setTimeout(()=>State.loadUserDetail(), 3000);
        } else Toast.error((data && data.error) || 'خطا در ثبت درخواست');
      } catch (err) { Toast.error(err.message || 'خطا در تحلیل فایل‌ها'); }
    }

    /* ═══════════════ CUSTOM KPI DRAWER ═══════════════ */
    const CustomKPI = (function () {
      const FORMULAS = [
        { value:'total', label:'تعداد کل فایل‌ها' },
        { value:'related', label:'تعداد فایل‌های مرتبط' },
        { value:'unrelated', label:'تعداد فایل‌های غیرمرتبط' },
        { value:'suspicious', label:'تعداد فایل‌های مشکوک' },
        { value:'relevance', label:'میانگین relevance' },
        { value:'related_pct', label:'درصد مرتبط' },
        { value:'susp_pct', label:'درصد مشکوک' },
        { value:'topics_count', label:'تعداد موضوعات' },
        { value:'org_count', label:'تعداد فایل‌های سازمانی' },
      ];
      const storageKey = (id) => 'insight_kpi_v1_'+id;
      function load(userId) {
        if (!userId) return [];
        try { const raw = localStorage.getItem(storageKey(userId)); if (!raw) return []; const a = JSON.parse(raw); return Array.isArray(a) ? a : []; }
        catch(e){ return []; }
      }
      function save(userId, kpis) { try { localStorage.setItem(storageKey(userId), JSON.stringify(kpis)); } catch(e){} }
      function add(label, formula) {
        const id = State.selectedUserId;
        if (!id) return;
        const kpis = load(id);
        kpis.push({ id: uid(), label, formula });
        save(id, kpis);
        State.customKpis = kpis;
        State.renderDashboard(); // simpler & safer than partial KPI refresh
        Toast.success('شاخص سفارشی افزوده شد');
      }
      function remove(kpiId) {
        const id = State.selectedUserId;
        if (!id) return;
        const kpis = load(id).filter(k => k.id !== kpiId);
        save(id, kpis);
        State.customKpis = kpis;
        State.renderDashboard();
        Toast.info('شاخص سفارشی حذف شد');
      }
      function openDrawer() {
        const id = State.selectedUserId;
        if (!id) return;
        const mount = $('#drawerMount');
        mount.innerHTML =
          '<div class="drawer-backdrop" id="drawerBackdrop"></div>'+
          '<div class="drawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle">'+
            '<div class="drawer-head"><h3 id="drawerTitle">افزودن شاخص سفارشی</h3><button class="icon-btn" id="drawerCloseBtn" aria-label="بستن">✕</button></div>'+
            '<div class="drawer-body">'+
              '<div class="field"><label for="kpiLabelInput">عنوان شاخص</label><input id="kpiLabelInput" type="text" placeholder="مثلاً درصد فایل‌های مشکوک" /></div>'+
              '<div class="field"><label for="kpiFormulaSelect">فرمول محاسبه</label><select id="kpiFormulaSelect">'+FORMULAS.map(f=>'<option value="'+f.value+'">'+f.label+'</option>').join('')+'</select><span class="hint">مقدار به‌صورت خودکار از داده‌های این کاربر محاسبه می‌شود.</span></div>'+
            '</div>'+
            '<div class="drawer-foot"><button class="btn" id="drawerCancelBtn">انصراف</button><button class="btn primary" id="drawerSaveBtn">ذخیره</button></div>'+
          '</div>';
        const close = ()=>{ mount.innerHTML = ''; };
        $('#drawerBackdrop', mount).addEventListener('click', close);
        $('#drawerCloseBtn', mount).addEventListener('click', close);
        $('#drawerCancelBtn', mount).addEventListener('click', close);
        $('#drawerSaveBtn', mount).addEventListener('click', ()=>{
          const label = ($('#kpiLabelInput', mount).value || '').trim();
          const formula = $('#kpiFormulaSelect', mount).value;
          if (!label) { Toast.warning('عنوان شاخص را وارد کنید'); return; }
          add(label, formula); close();
        });
      }
      return { load, add, remove, openDrawer, FORMULAS };
    })();

    /* ═══════════════ ROUTER ═══════════════ */
    const Router = {
      parse() {
        const hash = location.hash.replace(/^#/, '');
        const params = {};
        hash.split('&').forEach(part => {
          const [k, v] = part.split('=');
          if (k && v !== undefined) params[k] = decodeURIComponent(v);
        });
        return params;
      },
      sync() {
        const params = {};
        if (State.selectedUserId) params.user = State.selectedUserId;
        if (State.activeTab) params.tab = State.activeTab;
        const hash = Object.keys(params).map(k=>k+'='+encodeURIComponent(params[k])).join('&');
        if (hash) history.replaceState(null, '', '#'+hash);
        else history.replaceState(null, '', location.pathname);
      },
      handleHashChange() {
        const p = Router.parse();
        if (p.user) {
          const id = Number(p.user);
          if (!isNaN(id) && id !== State.selectedUserId) State.selectUser(id);
          if (p.tab && ['overview','files','chat','psychology'].includes(p.tab)) {
            const btn = document.getElementById('tab_'+p.tab);
            if (btn && !btn.classList.contains('active')) btn.click();
          }
        }
      },
      init() {
        window.addEventListener('hashchange', ()=>Router.handleHashChange());
        const p = Router.parse();
        if (p.user) { const id = Number(p.user); if (!isNaN(id)) State.selectUser(id); }
      }
    };

    /* ═══════════════ INIT ═══════════════ */
    (function init() {
      $('#sidebarToggle').addEventListener('click', ()=>$('#app').classList.toggle('collapsed'));
      Theme.syncIcon();
      $('#themeToggle').addEventListener('click', ()=>Theme.toggle());

      window.addEventListener('insight:theme-changed', ()=>{
        if (State.selectedUserId && State.activeTab === 'overview') State.renderOverviewCharts();
        if (State.selectedUserId && State.activeTab === 'files') State.renderFiles();
      });

      $('#refreshBtn').addEventListener('click', async ()=>{
        const btn = $('#refreshBtn');
        btn.classList.add('spinning');
        setTimeout(()=>btn.classList.remove('spinning'), 700);
        Toast.info('در حال به‌روزرسانی…');
        try {
          await Users.fetchUsers();
          if (State.selectedUserId) await State.loadUserDetail();
          Toast.success('به‌روزرسانی شد');
        } catch (err) { Toast.error('خطا در به‌روزرسانی'); }
      });

      $('#userSearch').addEventListener('input', debounce((e)=>Users.setFilter(e.target.value), 200));

      State._autoRefreshTimer = setInterval(()=>{
        if (document.visibilityState !== 'visible') return;
        if (!State.selectedUserId) return;
        if (State.activeTab === 'chat') return;
        Users.fetchUsers().catch(()=>{});
        apiFetch('/api/behavior-analysis/'+encodeURIComponent(State.selectedUserId)+'/')
          .then(data=>{
            if (data && data.success && State.selectedUserId) {
              State.userDetail = data;
              State.selectedUser = data.user || State.selectedUser;
              if (State.activeTab !== 'chat') State.renderDashboard();
            }
          }).catch(()=>{});
      }, 30000);

      document.addEventListener('visibilitychange', ()=>{
        if (document.visibilityState === 'visible' && State.selectedUserId && State.activeTab !== 'chat') {
          Users.fetchUsers().catch(()=>{});
          apiFetch('/api/behavior-analysis/'+encodeURIComponent(State.selectedUserId)+'/')
            .then(data=>{
              if (data && data.success && State.selectedUserId) {
                State.userDetail = data;
                State.selectedUser = data.user || State.selectedUser;
                if (State.activeTab !== 'chat') State.renderDashboard();
              }
            }).catch(()=>{});
        }
      });

      Users.fetchUsers();
      Router.init();
    })();
  </script>
</body>
</html>